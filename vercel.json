{
  "builds": [
    {
      "src": "api/run.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "office-animation.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/run.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/office",
      "dest": "/office-animation.html"
    }
  ]
}